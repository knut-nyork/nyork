# Kopier denne til .env og fyll inn. .env er gitignorert og skal aldri committes.
# De samme variablene må også legges inn i Netlify under Site settings → Environment variables.

PUBLIC_SANITY_PROJECT_ID=kh2746mt
PUBLIC_SANITY_DATASET=production

# Hentes i Sanity-dashbordet → API → Tokens. Bruk read-token, ikke write.
SANITY_READ_TOKEN=
