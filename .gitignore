# miljøvariabler — inneholder Sanity-token, skal ALDRI committes
.env
.env.*
!.env.example

# avhengigheter og bygg
node_modules/
dist/
.astro/
.netlify/
.vercel/

# Sanity
.sanity/

# Media: fotografier og video er kildefiler i full oppløsning.
# Produksjonsbilder kommer fra Sanity — se media/README.md.
media/foto/
media/video/

# Salgsoppgaven er 23 MB og hører hjemme i Sanity som nedlastbart dokument,
# ikke i git-historikken. Ligger her som kildefil.
media/salgsoppgave/

# Merkevare og tegninger brukes i kode og skal med
!media/merkevare/
!media/tegninger/

# Designsystemets demobilder — kun brukt av ui_kits-skjermene.
# Disse to er ikke referert noe sted og er til sammen 16 MB.
design-system/assets/images/hemsedal-2.jpg
design-system/assets/images/hemsedal-3.jpg

