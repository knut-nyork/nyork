---
import Bildeplassholder from './Bildeplassholder.tsx'
import Brodsmuler from './Brodsmuler.astro'
import Byggestatusmerke from './Byggestatusmerke.tsx'
import Pris from './Pris.tsx'
import Statusmerke from './Statusmerke.tsx'
import {bildeUrl} from '../lib/hytter'
import {stiForSprak, tekst, type Sprak} from '../lib/sprak'
import {UI} from '../lib/tekster'
import type {Enhet} from '../lib/typer'

/**
 * Enhetssiden — den konkrete hytta. Pris, status og byggetrinn hører hjemme
 * her; arkitekturen står på modellsiden det lenkes til, så tallene om
 * planløsning skrives bare ett sted.
 *
 * Lenken til Finn går ut herfra, aldri motsatt vei: detaljsiden skal ligge
 * hos oss. Se docs/01-byggeinstruks.md.
 *
 * Faktaene står i et eget panel med tre kolonner og skillelinjer mellom
 * radene. Det er det første en kjøper leter etter, og et panel leses raskere
 * enn en løpende liste. Radene deles opp i koden og ikke med CSS, fordi
 * skillelinjen skal ligge mellom radene og ikke under den siste.
 */
interface Props {
  sprak: Sprak
  enhet: Enhet
}

const {sprak, enhet} = Astro.props
const ui = UI[sprak].hytter
const modell = enhet.modell

const beskrivelse = tekst(enhet.beskrivelse, sprak)
const avsnitt = beskrivelse ? beskrivelse.split(/\n\s*\n/) : []
const hovedbilde = enhet.bilder?.[0]
const flerebilder = enhet.bilder?.slice(1) ?? []

/**
 * Prisen står ikke i denne lista. Den rendres som komponent fordi en
 * nedsatt pris har to tall og en overstreking, og lista holder bare tekst.
 */
const fakta = [
  modell ? {etikett: ui.hyttetype, verdi: modell.navn} : null,
  enhet.byggetrinn ? {etikett: ui.byggetrinn, verdi: String(enhet.byggetrinn)} : null,
  modell?.bra ? {etikett: ui.bra, verdi: `${modell.bra} m²`} : null,
  modell?.prom ? {etikett: ui.prom, verdi: `${modell.prom} m²`} : null,
  modell?.antallEtasjer ? {etikett: ui.etasjer, verdi: String(modell.antallEtasjer)} : null,
  modell?.antallSoverom ? {etikett: ui.soverom, verdi: String(modell.antallSoverom)} : null,
  modell?.antallBad ? {etikett: ui.bad, verdi: String(modell.antallBad)} : null,
  enhet.tomtestorrelse ? {etikett: ui.tomt, verdi: `${enhet.tomtestorrelse} m²`} : null,
  enhet.delomrade ? {etikett: ui.delomrade, verdi: enhet.delomrade} : null,
  tekst(enhet.utsiktsretning, sprak) ? {etikett: ui.utsikt, verdi: tekst(enhet.utsiktsretning, sprak)} : null,
  modell?.harBadstue ? {etikett: ui.badstue, verdi: ui.ja} : null,
].filter((rad) => rad !== null)

/** Tre per rad, slik at skillelinjene faller mellom rader og ikke under den siste. */
const faktarader: (typeof fakta)[] = []
faktarader.push(fakta.slice(0, 2))
for (let i = 2; i < fakta.length; i += 3) faktarader.push(fakta.slice(i, i + 3))

/**
 * Rytmen bildene legges i, som gjentar seg nedover. Bredden som hentes fra
 * Sanity følger plassen — et bilde over hele bredden trenger flere piksler
 * enn ett som ligger i en tredjedel.
 *
 * Tallene er valgt for liggende bilder, som er det de fleste hyttebilder er.
 * Et stående bilde beskjæres i toppen og bunnen; ligger et slikt feil i
 * rekkefølgen, er det raskere å flytte det i Sanity enn å lage flere regler
 * her.
 */
const BILDERYTME = [
  {kolonner: 'md:col-span-12', form: 'aspect-[16/9]', bredde: 1600},
  {kolonner: 'md:col-span-7', form: 'aspect-[4/3]', bredde: 1000},
  {kolonner: 'md:col-span-5', form: 'aspect-[4/3]', bredde: 800},
  {kolonner: 'md:col-span-5', form: 'aspect-square', bredde: 800},
  {kolonner: 'md:col-span-7', form: 'aspect-[3/2]', bredde: 1000},
  {kolonner: 'md:col-span-12', form: 'aspect-[21/9]', bredde: 1600},
]

---

<div class="mx-auto flex max-w-[1100px] flex-col gap-14 px-5 py-12 md:px-10">
  <Brodsmuler sprak={sprak} ledd={[{tekst: ui.alleHytter, sti: '/hytter'}]} naa={enhet.nummer} />

  <header class="flex flex-col items-center gap-4 py-6 text-center md:py-10">
    <h1 class="m-0 font-heading text-4xlarge font-semibold">{enhet.nummer}</h1>
    <div class="flex flex-wrap items-center justify-center gap-2">
      <Statusmerke status={enhet.status} sprak={sprak} />
      {enhet.byggestatus && <Byggestatusmerke byggestatus={enhet.byggestatus} sprak={sprak} />}
    </div>
  </header>

  {
    hovedbilde ? (
      <img
        src={bildeUrl(hovedbilde.url, 1400)}
        alt={tekst(hovedbilde.altTekst, sprak)}
        class="aspect-[16/10] w-full rounded-stor object-cover"
      />
    ) : (
      <Bildeplassholder sideforhold="16 / 10" className="w-full rounded-stor" />
    )
  }

  <!-- Faktaene står uten flate bak seg. Skillelinjene mellom radene holder
       tallene i kolonner, og uten panel ligger de på samme venstrekant som
       bildet og teksten rundt. -->
  <dl class="m-0 flex flex-col">
    {
      faktarader.map((rad, i) => (
        <div
          class:list={[
            'grid grid-cols-2 gap-x-6 gap-y-5 py-5 sm:grid-cols-3',
            i < faktarader.length - 1 && 'border-b border-border-subtle',
          ]}
        >
          {i === 0 && (
            <div class="flex flex-col gap-1">
              <dt class="font-heading text-xsmall font-semibold">{ui.pris}</dt>
              <dd class="m-0 font-body text-xsmall text-foreground-muted">
                <Pris pris={enhet.pris} opprinneligPris={enhet.opprinneligPris} sprak={sprak} />
              </dd>
            </div>
          )}
          {rad.map((celle) => (
            <div class="flex flex-col gap-1">
              <dt class="font-heading text-xsmall font-semibold">{celle.etikett}</dt>
              <dd class="m-0 font-body text-xsmall text-foreground-muted">{celle.verdi}</dd>
            </div>
          ))}
        </div>
      ))
    }
  </dl>

  {
    avsnitt.length > 0 && (
      <section class="flex flex-col gap-5">
        <h2 class="m-0 font-heading text-xlarge font-semibold">{ui.seHytta}</h2>
        {avsnitt.map((tekstavsnitt) => (
          <p class="m-0 max-w-[62ch] font-body text-xsmall">{tekstavsnitt}</p>
        ))}
      </section>
    )
  }

  <!--
    Bildene. Ni like ruter leses som et arkiv; her får de ulik størrelse i en
    rytme som gjentar seg, så siden puster mens du blar nedover.

    Rytmen er bevisst rolig og uten skjeve bilder. Kollasjen på forsiden skal
    lokke; dette galleriet skal vise rom. En kjøper som prøver å se hvor stor
    stua er, er ikke tjent med at bildet ligger på skrå.

    Uten bilder står to plassholdere med riktig sideforhold, slik at layouten
    ikke hopper den dagen bildene kommer.
  -->
  <div class="grid grid-cols-1 gap-5 md:grid-cols-12 md:gap-6">
    {
      flerebilder.length > 0 ? (
        flerebilder.map((bilde, i) => {
          const plass = BILDERYTME[i % BILDERYTME.length]

          return (
            <figure class:list={['stigfram m-0', plass.kolonner]}>
              {/* Rammen klipper zoomen på hover. Uten den vokser bildet ut over naboen. */}
              <div class="overflow-hidden rounded-stor">
                <img
                  src={bildeUrl(bilde.url, plass.bredde)}
                  alt={tekst(bilde.altTekst, sprak)}
                  loading="lazy"
                  class:list={[
                    'w-full object-cover transition-transform duration-700 motion-safe:hover:scale-[1.04]',
                    plass.form,
                  ]}
                />
              </div>
              {bilde.fotokreditt && (
                <figcaption class="mt-2 font-detail text-2xsmall text-foreground-muted">{bilde.fotokreditt}</figcaption>
              )}
            </figure>
          )
        })
      ) : (
        <>
          <Bildeplassholder sideforhold="4 / 3" className="rounded-stor md:col-span-6" />
          <Bildeplassholder sideforhold="4 / 3" className="rounded-stor md:col-span-6" />
        </>
      )
    }
  </div>

  {
    tekst(enhet.solforhold, sprak) && (
      <section class="flex flex-col gap-3">
        <h2 class="m-0 font-heading text-xlarge font-semibold">{ui.solforhold}</h2>
        <p class="m-0 max-w-[62ch] font-body text-xsmall">{tekst(enhet.solforhold, sprak)}</p>
      </section>
    )
  }

  <div class="flex flex-wrap gap-4">
    {
      modell && (
        <a href={stiForSprak(`/hytter/${modell.slug}`, sprak)} class="knapp knapp--primar">
          {ui.seHyttetypen}
        </a>
      )
    }
    {
      enhet.prospekt?.url && (
        <a href={enhet.prospekt.url} class="knapp knapp--sekundar">
          {ui.prospekt}
        </a>
      )
    }
    {
      enhet.finnAnnonseUrl && (
        <a href={enhet.finnAnnonseUrl} rel="noopener" target="_blank" class="knapp knapp--sekundar">
          {ui.finn}
        </a>
      )
    }
  </div>
</div>
