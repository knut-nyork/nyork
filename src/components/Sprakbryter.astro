---
import {SPRAK, stiForSprak, type Sprak} from '../lib/sprak'
import {UI} from '../lib/tekster'

/**
 * Språkvelgeren, som tre valg i samme ramme.
 *
 * Alle valgene er ekte lenker til hver sin URL, ikke en knapp som bytter
 * innhold. Det er poenget: norsk, engelsk og tysk er tre sider med hver sin
 * adresse som Google skal kunne finne hver for seg, og hreflang i Sidemal
 * peker på dem. En JavaScript-bryter ville gjort de to andre usynlige for søk.
 *
 * Etikettene er språkkodene, som skrives likt på alle språk og derfor ikke
 * oversettes. Lista kommer fra SPRAK, så et fjerde språk dukker opp her av seg
 * selv den dagen det legges til.
 */
interface Props {
  sprak: Sprak
  /** Den norske stien til siden vi står på, så vi bytter språk uten å bytte side. */
  norskSti: string
}

const {sprak, norskSti} = Astro.props
const ui = UI[sprak]
---

<div class="bryter" role="group" aria-label={ui.velgSprak}>
  {
    SPRAK.map((kode) => (
      <a
        href={stiForSprak(norskSti, kode)}
        hreflang={kode}
        lang={kode}
        aria-current={kode === sprak ? 'true' : undefined}
        class="bryter__valg"
      >
        {kode.toUpperCase()}
      </a>
    ))
  }
</div>
