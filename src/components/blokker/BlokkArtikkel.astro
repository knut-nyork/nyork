---
import Blokkknapp from './Blokkknapp.astro'
import Bildeplassholder from '../Bildeplassholder'
import {bildeUrl} from '../../lib/hytter'
import {tekst, type Sprak} from '../../lib/sprak'
import type {BlokkArtikkel} from '../../lib/typer'

/**
 * Bilde på den ene siden, tekst på den andre. Redaktøren velger hvilken side
 * bildet ligger på, slik at de kan veksle nedover siden.
 *
 * Legges det inn et ekstra bilde, står det mindre og forskjøvet oppå det
 * store, med hjørnet inn mot teksten. Det er retningen som gjør det: et
 * bilde som stikker utover mot skjermkanten ser ut som en feil, ett som
 * lener seg mot teksten binder de to spaltene sammen.
 *
 * Skillet mellom de to bildene er en kant i sideflatens farge, ikke en
 * skygge. Resten av siden løfter med farge; skygge er forbeholdt topplinja.
 *
 * Uten ekstra bilde er det bare det store. Ingen tom plass, ingen
 * plassholder — én god ting slår to der den ene mangler.
 *
 * På mobil ligger bildet alltid øverst — da leses siden i én kolonne, og
 * tekst før bilde ville skjøvet bildet langt ned.
 */
interface Props {
  blokk: BlokkArtikkel
  sprak: Sprak
}

const {blokk, sprak} = Astro.props

const brodtekst = tekst(blokk.tekst, sprak)
const avsnitt = brodtekst ? brodtekst.split(/\n\s*\n/) : []
const bilde = blokk.bilde
const ekstra = blokk.ekstrabilde
const bildeTilHoyre = blokk.bildeplassering === 'hoyre'
---

<section class="mx-auto max-w-[800px] px-5 py-20 md:px-10 md:py-32">
  <div class="grid items-center gap-8 md:grid-cols-2 md:gap-16">
    <div class:list={['flex flex-col gap-3', bildeTilHoyre ? 'md:order-1' : 'md:order-2']}>
      <h2 class="font-heading text-xlarge font-semibold md:text-2xlarge">{tekst(blokk.overskrift, sprak)}</h2>
      {avsnitt.map((tekstavsnitt) => <p class="max-w-[62ch] font-body text-xsmall">{tekstavsnitt}</p>)}
      {blokk.knapp && <div class="mt-3"><Blokkknapp knapp={blokk.knapp} sprak={sprak} /></div>}
    </div>

    <figure
      class:list={[
        'bildepar group relative m-0',
        bildeTilHoyre ? 'md:order-2' : 'md:order-1',
        // Plass til hjørnet som stikker ut. Bare på skrivebord — på mobil
        // ligger det lille bildet innenfor og trenger ingen klaring.
        ekstra && 'md:mb-8',
      ]}
    >
      {
        bilde ? (
          <img
            src={bildeUrl(bilde.url, 1200)}
            alt={tekst(bilde.altTekst, sprak)}
            loading="lazy"
            /* Liggende på mobil, stående på skrivebord. Et stående bilde i
               full skjermbredde blir en vegg på en telefon. */
            class="bildepar__stort aspect-[4/3] w-full rounded-stor object-cover md:aspect-[4/5]"
          />
        ) : (
          <Bildeplassholder sideforhold="4 / 3" className="md:aspect-[4/5]" />
        )
      }

      {
        ekstra && (
          <img
            src={bildeUrl(ekstra.url, 700)}
            alt={tekst(ekstra.altTekst, sprak)}
            loading="lazy"
            class:list={[
              'bildepar__lite rounded-medium border-4 border-flate-side object-cover',
              /* Mobil: eget bilde under det store, ikke oppå. En skjerm på
                 375 px har ikke plass til to bilder i lag — det lille dekker
                 motivet i stedet for å utfylle det, uansett hvor lite det er. */
              'mt-4 aspect-[4/3] w-full',
              /* Fra md legger det seg oppå, med hjørnet inn mot teksten. */
              'md:absolute md:-bottom-8 md:mt-0 md:aspect-square md:w-[46%]',
              bildeTilHoyre ? 'md:-left-6 md:right-auto' : 'md:-right-6 md:left-auto',
            ]}
          />
        )
      }

      {
        bilde?.fotokreditt && (
          <figcaption class:list={['font-detail text-2xsmall text-foreground-muted', ekstra ? 'mt-12' : 'mt-2']}>
            {bilde.fotokreditt}
          </figcaption>
        )
      }
    </figure>
  </div>
</section>
