---
import Galleribilde from './Galleribilde.astro'
import {tekst, type Sprak} from '../../lib/sprak'
import type {BlokkBilder} from '../../lib/typer'

/**
 * To til fire bilder som ikke står på like linjer.
 *
 * Symmetri er rolig, men også litt kjedelig — like store bilder på rad leses
 * som et arkivutdrag. Her er venstre spalte bred og høyre smal, og den smale
 * er dyttet nedover, så øyet får noe å følge.
 *
 * To spalter og ikke ett rutenett med ruter: i et rutenett havner bildene på
 * faste rader, og siden de er ulike høye, blir det stående hull etter det
 * korteste. Med spalter stables de tett.
 *
 * Bildene fordeles annenhver: første, tredje til venstre — andre, fjerde til
 * høyre. Redaktøren trenger bare tenke på rekkefølge, ikke på spalter.
 *
 * Forskyvningen gjelder bare fra `md` og opp. På en mobil er det én spalte,
 * og da er et bilde som er dyttet nedover ikke asymmetrisk — bare et hull.
 */
interface Props {
  blokk: BlokkBilder
  sprak: Sprak
}

const {blokk, sprak} = Astro.props

/**
 * Plassen hvert bilde får: sideforhold og hvor langt det driver når du ruller.
 *
 * Tallene er ulike med vilje — beveger alle likt, ser det ut som at hele
 * blokka sklir, og ikke som dybde. Høyre spalte driver motsatt vei av
 * venstre; det er den motsatte retningen som får spaltene til å løsne fra
 * hverandre. Drev de samme vei, ville det bare sett ut som at siden rullet
 * litt tregt.
 *
 * Negativ forsinkelse starter pusten midt i syklusen, så bildene ikke er i
 * takt fra første sekund.
 */
const PLASSER = [
  {form: 'aspect-[4/3]', vri: '-1.6deg', overlapp: '', bevegelse: {parallakse: '72px', tid: '9s', forsinkelse: '0s'}},
  {form: 'aspect-[4/5]', vri: '2.2deg', overlapp: '', bevegelse: {parallakse: '-104px', tid: '11s', forsinkelse: '-3.5s'}},
  {form: 'aspect-[3/2]', vri: '1.4deg', overlapp: 'md:-mt-8', bevegelse: {parallakse: '48px', tid: '10s', forsinkelse: '-7s'}},
  {form: 'aspect-square', vri: '-2.4deg', overlapp: 'md:-mt-10', bevegelse: {parallakse: '-84px', tid: '12s', forsinkelse: '-5s'}},
  {form: 'aspect-[3/2]', vri: '-1deg', overlapp: 'md:-mt-6', bevegelse: {parallakse: '92px', tid: '9.5s', forsinkelse: '-2s'}},
  {form: 'aspect-[4/3]', vri: '1.9deg', overlapp: 'md:-mt-8', bevegelse: {parallakse: '-66px', tid: '11.5s', forsinkelse: '-8s'}},
]

/** Skjemaet slipper bare gjennom to til fire. Kuttet her er et sikkerhetsnett. */
const bilder = (blokk.bilder ?? []).slice(0, PLASSER.length).map((bilde, i) => ({bilde, ...PLASSER[i]}))

/** Vridningen sendes inn som variabel, så CSS-en kan rette den opp på hover. */
const stil = (b: (typeof bilder)[number]) =>
  `--vri: ${b.vri}; --parallakse: ${b.bevegelse.parallakse}; --flyt-tid: ${b.bevegelse.tid}; --flyt-forsinkelse: ${b.bevegelse.forsinkelse}`

const venstre = bilder.filter((_, i) => i % 2 === 0)
const hoyre = bilder.filter((_, i) => i % 2 === 1)
---

{
  bilder.length > 0 && (
    <section class="mx-auto max-w-[800px] px-5 py-20 md:px-10 md:py-32">
      {blokk.overskrift && (
        <h2 class="mb-10 font-heading text-xlarge font-semibold md:text-2xlarge">
          {tekst(blokk.overskrift, sprak)}
        </h2>
      )}

      <div class="grid grid-cols-1 gap-5 md:grid-cols-12 md:items-start md:gap-6">
        <div class="flex flex-col gap-5 md:col-span-7 md:gap-6">
          {venstre.map((b) => (
            <Galleribilde bilde={b.bilde} form={b.form} stil={stil(b)} overlapp={b.overlapp} sprak={sprak} />
          ))}
        </div>

        {hoyre.length > 0 && (
          <div class="flex flex-col gap-5 md:col-span-5 md:mt-20 md:gap-6">
            {hoyre.map((b) => (
              <Galleribilde bilde={b.bilde} form={b.form} stil={stil(b)} overlapp={b.overlapp} sprak={sprak} />
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
