---
import {bildeUrl} from '../../lib/hytter'
import {stiForSprak, tekst, type Sprak} from '../../lib/sprak'
import type {BlokkFremhevet} from '../../lib/typer'

/**
 * Bilde i full bredde med tekstpanel oppå. Panelet har egen flate bak seg,
 * ikke bare skygge — teksten må være lesbar uansett hvor lyst bildet er.
 *
 * Er det satt en lenke, blir hele flaten klikkbar. Da er knappen inni bare
 * et merke og ikke en lenke i seg selv: en <a> inni en <a> er ugyldig, og
 * skjermlesere finner ingen god vei ut av det.
 *
 * Knappen vises bare på mobil. På et skrivebord forteller pekeren og
 * hover-effekten at flaten kan trykkes; på en berøringsskjerm finnes ingen
 * av delene, og da må det stå noe synlig.
 */
interface Props {
  blokk: BlokkFremhevet
  sprak: Sprak
}

const {blokk, sprak} = Astro.props

const brodtekst = tekst(blokk.tekst, sprak)
const avsnitt = brodtekst ? brodtekst.split(/\n\s*\n/) : []
const bilde = blokk.bilde

const knapp = blokk.knapp
const ekstern = knapp?.sti.startsWith('http') ?? false
const lenke = knapp ? (ekstern ? knapp.sti : stiForSprak(knapp.sti, sprak)) : undefined

/** Uten lenke er flaten bare en flate. Da skal den heller ikke oppføre seg som noe annet. */
const Flate = lenke ? 'a' : 'div'
---

<section class="mx-auto max-w-[800px] px-5 py-16 md:px-10 md:py-24">
  <Flate
    href={lenke}
    rel={ekstern ? 'noopener' : undefined}
    target={ekstern ? '_blank' : undefined}
    class:list={[
      'group relative block min-h-[420px] overflow-hidden rounded-stor bg-background-surface-3 no-underline',
    ]}
  >
    {
      bilde && (
        <img
          src={bildeUrl(bilde.url, 2000)}
          alt={tekst(bilde.altTekst, sprak)}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
        />
      )
    }

    <div class="relative flex min-h-[420px] items-end p-5 md:p-10">
      <div
        class="max-w-[52ch] rounded-medium bg-background-surface-1/90 p-6 backdrop-blur-sm transition-colors group-hover:bg-background-surface-1 md:p-8"
      >
        <h2 class="font-heading text-xlarge font-semibold group-hover:underline md:text-2xlarge">
          {tekst(blokk.overskrift, sprak)}
        </h2>
        {avsnitt.map((tekstavsnitt) => <p class="mt-3 font-body text-xsmall">{tekstavsnitt}</p>)}
        {
          knapp && (
            <span class:list={['knapp mt-6 md:hidden', bilde ? 'knapp--lys' : 'knapp--primar']}>
              {tekst(knapp.tekst, sprak)}
            </span>
          )
        }
      </div>
    </div>
  </Flate>

  {
    bilde?.fotokreditt && (
      <p class="mt-2 text-right font-detail text-2xsmall text-foreground-muted">{bilde.fotokreditt}</p>
    )
  }
</section>
