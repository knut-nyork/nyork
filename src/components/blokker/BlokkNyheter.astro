---
import Bildeplassholder from '../Bildeplassholder'
import Blokkknapp from './Blokkknapp.astro'
import {bildeUrl, formaterDato} from '../../lib/hytter'
import {stiForSprak, tekst, type Sprak} from '../../lib/sprak'
import {UI} from '../../lib/tekster'
import type {BlokkNyheter} from '../../lib/typer'

/**
 * Rad med nyhetssaker, to i bredden. Redaktøren velger i Sanity om det skal
 * være de nyeste automatisk eller saker de peker ut selv — valget er allerede
 * gjort når blokken kommer hit, se velgUtvalg() i sporringer.ts.
 *
 * Hele kortet er lenka, ikke bare tittelen. Et bilde og en dato som hører til
 * saken skal kunne trykkes de også — særlig på berøringsskjerm, der et
 * lenkeord er et lite mål.
 *
 * Kortet har flate og kant fordi det faktisk går et sted. Det er regelen
 * gjennom hele siden: kortflate betyr klikkbar. Formen er den samme som i
 * nyhetslista på /siste-nytt, så de to stedene ikke ser ut som to systemer.
 *
 * Saker med `skjulIListe` kan ikke havne her: de er filtrert bort både i det
 * automatiske utvalget og fra lista, så lenken peker alltid på en side som
 * finnes.
 */
interface Props {
  blokk: BlokkNyheter
  sprak: Sprak
}

const {blokk, sprak} = Astro.props
const ui = UI[sprak].forside
---

<section class="mx-auto max-w-[800px] px-5 py-20 md:px-10 md:py-32">
  <h2 class="font-heading text-xlarge font-semibold md:text-2xlarge">{tekst(blokk.overskrift, sprak)}</h2>

  {
    blokk.artikler.length === 0 ? (
      <p class="mt-6 font-body text-xsmall text-foreground-muted">{ui.ingenSaker}</p>
    ) : (
      <div class="mt-8 grid gap-6 md:grid-cols-2 md:gap-x-12">
        {blokk.artikler.map((sak) => (
          <a
            href={stiForSprak(`/siste-nytt/${sak.slug}`, sprak)}
            class="hevet group flex h-full flex-col gap-4 rounded-stor p-4 no-underline transition-colors hover:border-border-focus"
          >
            {/* Bildet zoomer innenfor sin egen ramme. Uten `overflow-hidden`
                her ville det vokst ut over kortkanten i stedet. */}
            <span class="overflow-hidden rounded-medium">
              {sak.bilde ? (
                <img
                  src={bildeUrl(sak.bilde.url, 700)}
                  alt={tekst(sak.bilde.altTekst, sprak)}
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.06]"
                />
              ) : (
                <Bildeplassholder sideforhold="4 / 3" />
              )}
            </span>

            <div class="flex flex-col gap-2 px-1 pb-1">
              <time datetime={sak.dato} class="font-detail text-2xsmall text-foreground-muted">
                {formaterDato(sak.dato, sprak)}
              </time>
              <h3 class="m-0 font-heading text-large font-semibold group-hover:underline">
                {tekst(sak.tittel, sprak)}
              </h3>
            </div>
          </a>
        ))}
      </div>
    )
  }

  {blokk.knapp && <div class="mt-8"><Blokkknapp knapp={blokk.knapp} sprak={sprak} variant="sekundar" /></div>}
</section>
