---
import {bildeUrl} from '../../lib/hytter'
import {tekst, type Sprak} from '../../lib/sprak'
import type {BlokkStatus, Statusrad, Statustall} from '../../lib/typer'

/**
 * Noen få nøkkeltall om salget, som et mørkt bånd på tvers av siden.
 *
 * Tall som *kan* telles, telles — ledige og solgte hytter hentes fra enhetene
 * i Sanity og kan derfor aldri bli utdaterte. Tall som ikke finnes i Sanity,
 * som salg fra tidligere byggetrinn eller en status som «Kommer», skrives inn
 * av redaktøren. Hvilken av delene hver rad er, velges i Studio.
 *
 * Båndet er mørkt i begge temaer, som footeren, og bruker samme flate. Det er
 * det eneste mørke feltet midt på en ellers lys forside, og det er poenget:
 * tallene er det harde, konkrete på siden, og skal skille seg fra teksten
 * rundt. Formspråket er hentet fra salgsoppgaven, der de dype flatene bærer.
 *
 * Legger redaktøren inn et bakgrunnsbilde, brukes det i stedet — da legges et
 * mørkt slør over, slik at tallene fortsatt er lesbare.
 *
 * Den røde prikken ved overskriften er en levende-markør: tallene er hentet
 * ved siste publisering, ikke skrevet inn for hånd.
 */
interface Props {
  blokk: BlokkStatus
  sprak: Sprak
  statustall: Statustall
}

const {blokk, sprak, statustall} = Astro.props

/** Teller enheter for en rad. Uten byggetrinn telles hele Nyørk. */
function tell(rad: Statusrad): number {
  const ettersokt = rad.kilde === 'solgte' ? 'solgt' : 'ledig'
  return statustall.enheter.filter(
    (e) =>
      e.enhetstype === 'hytte' &&
      e.status === ettersokt &&
      (rad.byggetrinn === undefined || rad.byggetrinn === null || e.byggetrinn === rad.byggetrinn),
  ).length
}

const rader = (blokk.rader ?? []).map((rad) => {
  const verdi = rad.kilde === 'manuelt' ? tekst(rad.verdi, sprak) : String(tell(rad))

  /* Bare hele tall kan telles opp. En rad kan like gjerne si «Kommer». */
  return {etikett: tekst(rad.etikett, sprak), verdi, tellbar: /^\d+$/.test(verdi)}
})

const overskrift = tekst(blokk.overskrift, sprak)
const bilde = blokk.bakgrunnsbilde
---

{
  rader.length > 0 && (
    <section class="relative overflow-hidden bg-flate-footer text-tekst-footer">
      {bilde && (
        <>
          <img
            src={bildeUrl(bilde.url, 2400)}
            alt={tekst(bilde.altTekst, sprak)}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
          {/* Mørkt slør, ikke lyst: teksten på båndet er lys. */}
          <div class="absolute inset-0 bg-black/55" aria-hidden="true" />
        </>
      )}

      <div class="relative mx-auto max-w-[800px] px-5 py-20 md:px-10 md:py-32">
        {overskrift && (
          <h2 class="mb-8 mt-0 flex items-center gap-2.5 font-heading text-xlarge font-semibold">
            <span class="prikk-levende" aria-hidden="true" />
            {overskrift}
          </h2>
        )}

        <dl class="m-0 grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4">
          {rader.map((rad) => (
            <div class="flex flex-col gap-2 border-t border-white/25 pt-4">
              {/* `tabular-nums` holder bredden i ro mens sifrene løper. */}
              <dd
                class="m-0 font-heading text-3xlarge font-semibold leading-none tabular-nums"
                data-statustall={rad.tellbar ? rad.verdi : undefined}
              >
                {rad.verdi}
              </dd>
              <dt class="font-body text-xsmall leading-snug opacity-70">{rad.etikett}</dt>
            </div>
          ))}
        </dl>

        {bilde?.fotokreditt && (
          <p class="mt-8 mb-0 text-right font-detail text-2xsmall opacity-60">{bilde.fotokreditt}</p>
        )}
      </div>
    </section>
  )
}

<script>
  /**
   * Tallene teller opp idet båndet kommer inn i skjermen.
   *
   * Det ferdige tallet står i HTML-en fra før. Skriptet nullstiller først i
   * det øyeblikket opptellingen begynner — ikke ved sidelast. Da har den som
   * har JavaScript av, den som søker i sida, og den som får den lest opp,
   * alltid det riktige tallet, og ingen ser en null som blir hengende.
   *
   * Rader som ikke er tall — «Kommer» og liknende — har ingen
   * `data-statustall` og røres ikke.
   */
  const felter = document.querySelectorAll<HTMLElement>('[data-statustall]')
  const villeHaRo = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (felter.length > 0 && !villeHaRo) {
    const VARIGHET = 900
    /* Et lite pust før det første tallet begynner, så opptellingen ikke
       starter i samme øyeblikk som båndet skyves inn i skjermen. */
    const VENT = 140
    /* Og litt mellom hvert tall, så de fire ikke løper i takt. */
    const TRINN = 90

    function tellOpp(felt: HTMLElement, mal: number) {
      const start = performance.now()

      function steg(naa: number) {
        const del = Math.min((naa - start) / VARIGHET, 1)
        // Bremser mot slutten, så det siste tallet lander i stedet for å stoppe brått.
        const lettet = 1 - Math.pow(1 - del, 3)
        felt.textContent = String(Math.round(mal * lettet))
        if (del < 1) requestAnimationFrame(steg)
      }

      requestAnimationFrame(steg)
    }

    const speider = new IntersectionObserver(
      (oppslag) => {
        for (const oppslaget of oppslag) {
          if (!oppslaget.isIntersecting) continue

          const felt = oppslaget.target as HTMLElement
          speider.unobserve(felt)

          const mal = Number(felt.dataset.statustall)
          if (!Number.isFinite(mal)) continue

          /* Nullstilles først når turen kommer, ikke i det blokka blir synlig.
             Ellers står de bakerste tallene på null mens de venter. */
          const plass = Array.prototype.indexOf.call(felter, felt)
          window.setTimeout(() => {
            felt.textContent = '0'
            tellOpp(felt, mal)
          }, VENT + plass * TRINN)
        }
      },
      // Vent til båndet faktisk er synlig, ikke bare så vidt over kanten.
      {threshold: 0.4},
    )

    felter.forEach((felt) => speider.observe(felt))
  }
</script>
