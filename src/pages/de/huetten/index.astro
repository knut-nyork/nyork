---
import Sidemal from '../../../layouts/Sidemal.astro'
import Hytterside from '../../../components/Hytterside.astro'
import {hentHytter, hentModeller, hentSide} from '../../../lib/sporringer'
import {tekst} from '../../../lib/sprak'

const [side, modeller, enheter] = await Promise.all([hentSide('hytter'), hentModeller(), hentHytter()])
---

<Sidemal
  norskSti="/hytter"
  tittel={tekst(side?.tittel, 'de')}
  metaBeskrivelse={tekst(side?.metaBeskrivelse, 'de')}
>
  <Hytterside sprak="de" side={side} modeller={modeller} enheter={enheter} />
</Sidemal>
