---
import Sidemal from '../../../layouts/Sidemal.astro'
import Omradeside from '../../../components/Omradeside.astro'
import {hentOmradeseksjoner, hentSide} from '../../../lib/sporringer'
import {tekst} from '../../../lib/sprak'

const [side, seksjoner] = await Promise.all([hentSide('omradet'), hentOmradeseksjoner()])
---

<Sidemal
  norskSti="/omradet"
  tittel={tekst(side?.tittel, 'en')}
  metaBeskrivelse={tekst(side?.metaBeskrivelse, 'en')}
>
  <Omradeside sprak="en" side={side} seksjoner={seksjoner} />
</Sidemal>
