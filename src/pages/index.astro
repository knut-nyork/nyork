---
import Sidemal from '../layouts/Sidemal.astro'
import Forside from '../components/Forside.astro'
import {hentSide, hentStatustall} from '../lib/sporringer'
import {tekst} from '../lib/sprak'

const [side, statustall] = await Promise.all([hentSide('forside'), hentStatustall()])
---

<Sidemal
  norskSti="/"
  tittel={tekst(side?.tittel, 'no')}
  metaBeskrivelse={tekst(side?.metaBeskrivelse, 'no')}
>
  <Forside sprak="no" side={side} statustall={statustall} />
</Sidemal>
