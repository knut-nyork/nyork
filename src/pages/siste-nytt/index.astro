---
import Sidemal from '../../layouts/Sidemal.astro'
import Nyhetsliste from '../../components/Nyhetsliste.astro'
import {hentArtikler, hentSide} from '../../lib/sporringer'
import {tekst} from '../../lib/sprak'

const [side, artikler] = await Promise.all([hentSide('siste-nytt'), hentArtikler()])
---

<Sidemal
  norskSti="/siste-nytt"
  tittel={tekst(side?.tittel, 'no')}
  metaBeskrivelse={tekst(side?.metaBeskrivelse, 'no')}
>
  <Nyhetsliste sprak="no" side={side} artikler={artikler} />
</Sidemal>
