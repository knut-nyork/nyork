---
import Sidemal from '../../layouts/Sidemal.astro'
import Tomteside from '../../components/Tomteside.astro'
import {hentReguleringsregler, hentSide, hentTomter} from '../../lib/sporringer'
import {tekst} from '../../lib/sprak'

/**
 * Siden bygges også når det ikke finnes tomter. Da vises den tomme tilstanden,
 * og menypunktet skjules automatisk — se synligNavigasjon() i lib/hytter.ts.
 * URL-en skal svare uansett, slik at delte lenker ikke brekker.
 */
const [side, tomter, regler] = await Promise.all([hentSide('tomter'), hentTomter(), hentReguleringsregler()])
---

<Sidemal
  norskSti="/tomter"
  tittel={tekst(side?.tittel, 'no')}
  metaBeskrivelse={tekst(side?.metaBeskrivelse, 'no')}
>
  <Tomteside sprak="no" side={side} tomter={tomter} regler={regler} />
</Sidemal>
